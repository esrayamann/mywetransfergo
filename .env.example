# PostgreSQL
DATABASE_URL=postgres://mywetransfer:change-me@localhost:5432/mywetransfer?sslmode=disable

# SMTP (use an app password or provider-specific credential)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace-with-a-secret
SMTP_FROM=no-reply@example.com

# Application
APP_BASE_URL=http://localhost:8081
# Generate a unique value of at least 32 characters for every environment.
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Set to true only behind HTTPS in production.
COOKIE_SECURE=false
MAX_UPLOAD_SIZE_MB=25
